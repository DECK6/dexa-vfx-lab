{
  "name": "dexa-vfx-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-manifest.mjs",
    "dev": "bun run gen && vite",
    "build": "bun run gen && bun run lint:registry && bun run lint:catalog && bun run lint:neighbors && tsc --noEmit && vite build && bun run check:bundle",
    "preview": "vite preview",
    "typecheck": "bun run gen && tsc --noEmit",
    "lint:registry": "node scripts/lint-registry.mjs",
    "lint:catalog": "node scripts/lint-catalog.mjs",
    "lint:neighbors": "node scripts/lint-neighbors.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "studio": "bun run gen && remotion studio src/remotion/index.ts",
    "thumbs": "bun run gen && bun scripts/thumbs.mjs",
    "audit:contact-sheets": "bun scripts/contact-sheets.mjs",
    "test:e2e": "playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.478",
    "@remotion/player": "4.0.478",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.478"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
